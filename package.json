{
  "name": "private-security-bot",
  "version": "1.0.0",
  "description": "Private Discord Security & Moderation Bot",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts",
    "service:start": "pm2 start ecosystem.config.js",
    "service:stop": "pm2 stop ecosystem.config.js",
    "service:restart": "pm2 restart ecosystem.config.js",
    "service:logs": "pm2 logs security-bot",
    "service:status": "pm2 list"
  },
  "dependencies": {
    "@discordjs/rest": "^2.3.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
