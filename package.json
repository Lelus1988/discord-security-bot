{
  "name": "private-security-bot",
  "version": "1.0.0",
  "description": "Private Discord Security & Moderation Bot",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts",
    "service:start": "pm2 start ecosystem.config.js",
    "service:stop": "pm2 stop ecosystem.config.js",
    "service:restart": "pm2 restart ecosystem.config.js",
    "service:logs": "pm2 logs security-bot",
    "service:status": "pm2 list"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "mongodb": "^7.5.0",
    "mongoose": "^8.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
