# ========================
# Discord Bot Configuration
# ========================

# Your bot token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Your application client ID
CLIENT_ID=your_client_id_here

# OAuth2 client secret (for web panel)
CLIENT_SECRET=your_client_secret_here

# The Discord User ID of the bot owner
OWNER_ID=1454112721174921343

# Comma-separated list of allowed guild IDs
ALLOWED_GUILDS=guild_id_1,guild_id_2

# Whether the bot should auto-leave unauthorized guilds (true/false)
AUTO_LEAVE=true

# ========================
# Database
# ========================

# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/securitybot

# ========================
# Anti-Raid Settings
# ========================

ANTI_RAID_ENABLED=true
ANTI_RAID_JOIN_THRESHOLD=5
ANTI_RAID_WINDOW_SEC=10
ANTI_RAID_LOCKDOWN_SEC=300

# ========================
# Anti-Spam Settings
# ========================

ANTI_SPAM_ENABLED=true
ANTI_SPAM_MSG_THRESHOLD=5
ANTI_SPAM_WINDOW_SEC=10
ANTI_SPAM_MENTION_LIMIT=5
ANTI_SPAM_MUTE_DURATION_MS=300000

# ========================
# Web Panel (runs in the SAME process as the bot)
# ========================

# Port for the web dashboard
WEB_PORT=3000

# Secret for express sessions (generate a random string, e.g. via `openssl rand -hex 32`)
SESSION_SECRET=a_very_long_random_secret_string_here

# Redirect URI registered in Discord Developer Portal -> OAuth2 -> Redirects
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback
